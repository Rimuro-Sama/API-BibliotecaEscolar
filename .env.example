# Copie para ".env" e troque os valores. O arquivo ".env" está no .gitignore: nunca o envie ao GitHub.
# Os valores abaixo são marcadores, não senhas reais: use senhas longas e únicas.

# Banco de dados (PostgreSQL)
DB_USER=biblioteca
DB_PASSWORD=troque-esta-senha

# Acesso à API (HTTP Basic): o usuário do bibliotecário
BIBLIOTECA_ADMIN_USER=bibliotecario
BIBLIOTECA_ADMIN_PASSWORD=troque-esta-senha-tambem
